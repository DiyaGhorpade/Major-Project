# Optional environment overrides (copy to .env and export, or set in your service manager). No secrets are needed:
# the service makes no outbound network calls.
PLANT_ML_API_HOST=127.0.0.1
PLANT_ML_API_PORT=8001
# PLANT_ML_ARTIFACTS_DIR=/opt/money_plant/artifacts
# PLANT_ML_CONFIG=/opt/money_plant/config/config.yaml
# Only set to 1 if you accept loading artifacts trained with different scikit-learn / xgboost versions:
# PLANT_ML_ALLOW_VERSION_MISMATCH=0
