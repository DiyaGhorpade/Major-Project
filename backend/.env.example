# Copy to .env and adjust. All values shown are the defaults.
ML_SERVICE_URL=http://127.0.0.1:8001
# Paths below are resolved relative to the backend/ directory (not the cwd) when relative.
# Dataset path default: ../money_plant_ml_pipeline/data/raw/plant_sensor_data.csv
DATASET_PATH=../money_plant_ml_pipeline/data/raw/plant_sensor_data.csv
ML_CONFIG_PATH=../money_plant_ml_pipeline/config/config.yaml
ML_REPORTS_DIR=../money_plant_ml_pipeline/reports
ML_ARTIFACTS_DIR=../money_plant_ml_pipeline/artifacts
DATABASE_URL=sqlite:///./data/app.db
ML_TIMEOUT_S=10
ML_CONCURRENCY=4
EXPLAIN_MODE=latest_only
HISTORY_ROWS_DEFAULT=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
